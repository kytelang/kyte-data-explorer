// The activity rail (VS Code style). The database plug opens the connection modal
// (loads the connect form into #modal-root); the others are visual placeholders, wired
// in later sessions. The plug carries the active accent bar.
pub fn activityBar(): Html {
    return <nav class="activitybar">
        <div class="top">
            <button class="act active" type="button" title="Database Connections"
                    hx-get="/connect" hx-target="#modal-root" hx-swap="innerHTML"><i class="ic ic-plug"></i></button>
            <button class="act" type="button" title="Search"><i class="ic ic-search"></i></button>
            <button class="act" type="button" title="Explorer"><i class="ic ic-files"></i></button>
        </div>
        <div class="bottom">
            <button class="act" id="theme-toggle" type="button" title="Toggle light / dark theme"><i class="ic ic-moon"></i></button>
            <button class="act" type="button" title="Settings"><i class="ic ic-gear"></i></button>
        </div>
    </nav>;
}
