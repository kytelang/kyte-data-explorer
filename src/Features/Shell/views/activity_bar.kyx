// The left activity rail (VS Code style): icon buttons that switch the content pane.
// "DB" opens the connect form, "SQL" opens the query editor; both htmx-swap into the
// content area. "Log" (query history) is a later session.
pub fn activityBar(): Html {
    return <nav class="activitybar">
        <button class="act" title="Connect" type="button"
                hx-get="/connect" hx-target="#content" hx-swap="innerHTML">DB</button>
        <button class="act" title="SQL editor" type="button"
                hx-get="/query" hx-target="#content" hx-swap="innerHTML">SQL</button>
        <button class="act" title="History" type="button">Log</button>
    </nav>;
}
