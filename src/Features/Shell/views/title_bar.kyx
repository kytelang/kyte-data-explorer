// The window title bar: macOS-style traffic lights, the product name, the centred
// active-connection line, and a File/Edit/View/Help menu. The centred connection text
// refreshes on the `connected` event via htmx (see the composition in layout.kyx).
pub fn titleBar(connText: string): Html {
    return <header class="titlebar">
        <div class="titlebar-left">
            <div class="traffic">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
            </div>
            <span class="brand">Kyte Data Studio</span>
        </div>
        <div class="titlebar-conn" id="titlebar-conn"
             hx-get="/chrome?part=title" hx-trigger="connected from:body" hx-swap="innerHTML">{connText}</div>
        <nav class="titlebar-menu">
            <button type="button">File</button>
            <button type="button">Edit</button>
            <button type="button">View</button>
            <button type="button">Help</button>
        </nav>
    </header>;
}
