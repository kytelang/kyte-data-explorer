// The studio page shell: a thin activity rail, the object-explorer tree, a query
// workspace (tabs + Run toolbar + Monaco editor + results pane), and a status bar, plus a
// modal root for the connection dialog. There is deliberately no in-app title bar: the
// desktop build hosts the studio in a native webview window that already supplies window
// chrome, and in the browser the tab bar plays that role. The editor and results live in
// the shell (not swapped), so Monaco initialises once on load (studio.js). The explorer,
// status and toolbar-connection fragments refresh on the htmx `connected` event.
import Features.Shell.views.activity_bar;
import Features.Shell.views.status_bar;

pub fn page(connected: bool, host: string, port: string, dbname: string, engine: string, titleText: string, connLabel: string): Html {
    return <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>Kyte Data Studio</title>
            <link rel="stylesheet" href="/studio.css"/>
            <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.52.2/min/vs/loader.min.js"></script>
            <script src="/studio.js"></script>
        </head>
        <body>
            <div class="app">
                <div class="workbench">
                    {activityBar()}
                    <aside class="explorer">
                        <div class="explorer-head">
                            <span class="explorer-title">Object Explorer</span>
                            <div class="explorer-actions">
                                <button id="btn-new-table" type="button" title="New Table (select a database)" disabled
                                        hx-get="/ddl/table" hx-target="#modal-root" hx-swap="innerHTML"><i class="ic ic-table-add"></i></button>
                                <button id="btn-new-index" type="button" title="New Index (select a table)" disabled
                                        hx-get="/ddl/index" hx-target="#modal-root" hx-swap="innerHTML"><i class="ic ic-index-add"></i></button>
                                <button type="button" title="Refresh Active Schema"
                                        hx-get="/explorer" hx-target="#explorer-body" hx-swap="innerHTML"><i class="ic ic-refresh"></i></button>
                            </div>
                        </div>
                        <div class="explorer-body" id="explorer-body"
                             hx-get="/explorer" hx-trigger="connected from:body" hx-swap="innerHTML">
                            {explorerInitial(connected)}
                        </div>
                    </aside>

                    <section class="workspace">
                        <div class="tabsbar">
                            <div class="tabrow" id="tabrow"></div>
                            <button class="tab-add" id="tab-add" type="button" title="New query tab">+</button>
                        </div>
                        <div class="toolbar">
                            <div class="left">
                                <button class="btn-run" id="run-btn" type="button" title="Run (Cmd/Ctrl+Enter)"
                                        hx-post="/query" hx-include="#sql-src"
                                        hx-target="#results-body" hx-swap="innerHTML"
                                        hx-indicator="#run-spin"><i class="ic ic-play"></i></button>
                                <button class="btn-cancel" type="button" title="Cancel" disabled><i class="ic ic-stop"></i></button>
                                <span class="toolbar-sep">|</span>
                                <button class="btn-format" type="button" title="Format SQL"><i class="ic ic-format"></i></button>
                                <span id="run-spin" class="htmx-indicator" style="color:var(--ok-fg);font-size:12px">running...</span>
                            </div>
                            <div class="right">
                                <i class="ic ic-bolt" title="Active connection"></i>
                                <span class="conn-pill" id="toolbar-conn"
                                      hx-get="/chrome?part=toolbar" hx-trigger="connected from:body" hx-swap="innerHTML">{connLabel}</span>
                            </div>
                        </div>
                        <div class="editor-wrap">
                            <textarea id="sql-src" name="sql" class="sql-hidden"></textarea>
                            <div id="editor"></div>
                        </div>
                        <div class="splitter"></div>
                        <div class="resultspane">
                            <div class="results-head">
                                <div class="results-tabs">
                                    <button class="results-tab active" type="button" data-tab="results">Results</button>
                                    <button class="results-tab" type="button" data-tab="messages">Messages</button>
                                </div>
                                <div class="export">
                                    <button type="button" data-export="csv" title="Save as CSV"><i class="ic ic-save"></i> CSV</button>
                                    <button type="button" data-export="json" title="Save as JSON"><i class="ic ic-save"></i> JSON</button>
                                    <button type="button" data-export="xls" title="Save as Excel"><i class="ic ic-save"></i> Excel</button>
                                </div>
                            </div>
                            <div class="results-body" id="results-body">
                                <div class="results-empty"><span><i class="ic ic-table"></i>&nbsp;&nbsp;No results to display. Run a SQL query to see data.</span></div>
                            </div>
                        </div>
                    </section>
                </div>
                {statusBar(statusLeft(connected, host, engine, dbname))}
                <div class="modal-root" id="modal-root"></div>
            </div>
        </body>
    </html>;
}

// The explorer body before any `connected` event has fired: the empty state when not
// connected, or (on a full reload with an active connection) a prompt to refresh.
fn explorerInitial(connected: bool): Html {
    if (connected) {
        return <div class="oe-loading" hx-get="/explorer" hx-trigger="load" hx-swap="innerHTML">
            <p class="muted" style="color:#888;padding:8px">Loading schema...</p>
        </div>;
    }
    return <div class="oe-empty">
        <span class="icon"><i class="ic ic-plug"></i></span>
        <p>No active database connections.</p>
        <button type="button" hx-get="/connect" hx-target="#modal-root" hx-swap="innerHTML">Add Connection</button>
    </div>;
}
