// The Shell feature's route table: the studio page, the liveness probe, and the
// connection-aware chrome fragments. Registered once from the composition root.
import Shared.AppContext;
import Features.Shell.handler;

pub fn registerShell(ctx: AppContext): void {
    ctx.app.get("/", ShellHandler(ctx.conn));
    ctx.app.get("/healthz", HealthzHandler());
    ctx.app.get("/chrome", ChromeHandler(ctx.conn));
}
