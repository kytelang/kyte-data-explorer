// The shell feature's handlers: the studio page at GET "/", a liveness probe at
// GET "/healthz", and GET "/chrome" for the small connection-aware fragments (status
// bar left, toolbar connection label) that refresh on the htmx `connected` event. All
// read the ACTIVE connection from the shared ConnStore.
import web.routing;
import web.response;
import web.status;
import string;
import Shared.Session;
import Features.Shell.views.layout;
import Features.Shell.views.status_bar;
import Features.Shell.command;

// The active connection's engine key, or "" when nothing is connected.
fn engineOf(store: ConnStore): string {
    let c = store.active();
    if (c == undefined) { return ""; }
    return c.dbtype;
}

// The toolbar connection label: "kaidb 127.0.0.1:3009/default" or "Not connected".
fn pillOf(store: ConnStore): string {
    let c = store.active();
    if (c == undefined) { return "Not connected"; }
    return c.label();
}

// The title-bar line (kept for the /chrome contract even though the title bar is gone).
fn titleTextOf(store: ConnStore): string {
    let c = store.active();
    if (c == undefined) { return "Not Connected"; }
    return c.dbname + " - " + c.dbtype + " - " + c.host;
}

pub struct ShellHandler impl RouteHandler {
    store: ConnStore,
    init(store: ConnStore) { self.store = store; }

    async fn serve(self: ShellHandler, ctx: Context): Response {
        let s = self.store;
        // Explicit narrowing rather than `c?.field` optional-chaining: chaining on a
        // value-struct optional proved fragile under concurrent fragment fetches.
        let c = s.active();
        let host = "";
        let port = "";
        let dbname = "";
        if (c != undefined) { host = c.host; port = c.port; dbname = c.dbname; }
        let body = "<!doctype html>\n" + page(s.isConnected(), host, port, dbname, engineOf(s), titleTextOf(s), pillOf(s));
        return response.Response(Status.Ok, body)
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}

// GET /chrome?part=status|toolbar|title: connection-aware fragments refreshed on connect.
pub struct ChromeHandler impl RouteHandler {
    store: ConnStore,
    init(store: ConnStore) { self.store = store; }

    async fn serve(self: ChromeHandler, ctx: Context): Response {
        let q = ctx.bind<ChromePart>();
        let s = self.store;
        // Read the active connection's fields via explicit narrowing (not `c?.field`):
        // optional-chaining on a value-struct optional proved fragile under the concurrent
        // fragment fetches the browser fires on the `connected` event.
        //
        // Plain-text fragments (no markup): pass the string straight to the body.
        // Response.serialize never escapes the body, so no response.raw() wrap is
        // needed here (and wrapping a local string as Html corrupts the value).
        let c = s.active();
        let host = "";
        let dbname = "";
        if (c != undefined) { host = c.host; dbname = c.dbname; }
        if (string.eql(q.part, "status")) {
            return response.Response(Status.Ok, statusLeft(s.isConnected(), host, engineOf(s), dbname))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let text = titleTextOf(s);
        if (string.eql(q.part, "toolbar")) { text = pillOf(s); }
        return response.Response(Status.Ok, text)
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}

// Liveness probe.
pub struct HealthzHandler impl RouteHandler {
    init() {}
    async fn serve(self: HealthzHandler, ctx: Context): Response {
        return response.Response(Status.Ok, "ok")
            .setHeader("Content-Type", "text/plain; charset=utf-8");
    }
}
