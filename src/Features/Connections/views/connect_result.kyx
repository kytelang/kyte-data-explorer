// The connect outcome fragment, swapped into #conn-result after a POST /connect.
// Green on success (with the probe message), red on failure (with the driver error).
pub fn connectResult(ok: bool, message: string): Html {
    if (ok) {
        return <div class="result ok">
            <strong>Connected</strong>
            <span>{message}</span>
        </div>;
    }
    return <div class="result err">
        <strong>Connection failed</strong>
        <span>{message}</span>
    </div>;
}
