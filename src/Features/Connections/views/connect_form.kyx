// The connection form, loaded into the content area by the "Connect a database" button.
// It POSTs to /connect and swaps the returned result fragment into #conn-result. Only
// kaidb is wired this session; the dbtype select carries the others for later sessions.
pub fn connectForm(): Html {
    return <div class="conn-form">
        <h2>Connect a database</h2>
        <form hx-post="/connect" hx-target="#conn-result" hx-swap="innerHTML">
            <label>Type
                <select name="dbtype">
                    <option value="kaidb">kaidb</option>
                    <option value="postgres">Postgres (soon)</option>
                    <option value="mysql">MySQL (soon)</option>
                    <option value="mssql">MSSQL (soon)</option>
                    <option value="mongodb">MongoDB (soon)</option>
                </select>
            </label>
            <label>Host <input name="host" value="127.0.0.1"/></label>
            <label>Port <input name="port" value="3009" placeholder="3009"/></label>
            <label>User <input name="user" placeholder="(optional)"/></label>
            <label>Password <input name="password" type="password" placeholder="(optional)"/></label>
            <label>Database <input name="dbname" placeholder="default"/></label>
            <button type="submit">Connect</button>
        </form>
        <div id="conn-result" class="conn-result"></div>
    </div>;
}
