// The Connections handlers, driving the connection modal.
//
// GET /connect  -> render the modal into #modal-root.
// POST /connect -> bind the form and probe the target. On success, record the active
//                  connection, return an EMPTY body (which clears #modal-root, closing
//                  the modal) and fire `HX-Trigger: connected` so the explorer, title,
//                  status bar and toolbar refresh. On failure, return the modal again
//                  with the error banner.
import web.routing;
import web.response;
import web.status;
import string;
import Features.Connections.command;
import Features.Connections.views.connect_form;
import Shared.Db;
import Shared.Session;

// GET /connect: the modal, no error.
pub struct GetConnectFormHandler impl RouteHandler {
    init() {}

    async fn serve(self: GetConnectFormHandler, ctx: Context): Response {
        return response.Response(Status.Ok, connectModal(""))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}

// POST /connect: probe and, on success, record + close.
pub struct ConnectHandler impl RouteHandler {
    conn: ActiveConnection,
    init(conn: ActiveConnection) { self.conn = conn; }

    async fn serve(self: ConnectHandler, ctx: Context): Response {
        let f = ctx.bind<ConnectForm>();
        if (!string.eql(f.dbtype, "kaidb")) {
            return response.Response(Status.Ok, connectModal(f.dbtype + " is not wired yet; kaidb is supported in this build."))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let r = await probeKaidb(f.host, f.port, f.user, f.password, f.dbname);
        if (r.ok) {
            let dsn = kaidbDsn(f.host, f.port, f.user, f.password, f.dbname);
            self.conn.set("kaidb", dsn, f.host, f.port, f.dbname);
            // Close the modal and announce the connection. We dispatch `connected` on
            // <body> from a script rather than via an HX-Trigger header: the header
            // fires the event on the triggering form, which this swap removes, so it
            // would never reach the body-level listeners on the explorer, title, status
            // bar and toolbar.
            let js = "<script>(function(){var m=document.getElementById('modal-root');if(m){m.innerHTML='';}if(window.htmx){htmx.trigger(document.body,'connected');}})();</script>";
            return response.Response(Status.Ok, response.raw(js))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        return response.Response(Status.Ok, connectModal(r.message))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}
