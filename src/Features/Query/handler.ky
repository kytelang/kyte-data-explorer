// The Query feature handler: POST /query runs the submitted SQL against the active
// connection and returns the results-pane body (grid + messages) into #results-body.
import web.routing;
import web.response;
import web.status;
import string;
import Shared.Session;
import Shared.Db;
import Shared.Mongo;
import Features.Query.command;
import Features.Query.views.results_pane;
import Features.Query.views.mongo_results;

pub struct RunQueryHandler impl RouteHandler {
    store: ConnStore,
    init(store: ConnStore) { self.store = store; }

    async fn serve(self: RunQueryHandler, ctx: Context): Response {
        let f = ctx.bind<QueryForm>();
        let c = self.store.active();
        if (c == undefined) {
            let r = Db.QueryResult();
            r.error = "Not connected. Connect a database first.";
            return response.Response(Status.Ok, resultsPane(r))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        // Mongo runs a find over a collection, not SQL: the query box is
        // "<collection> [field=value]". Documents come back as JSON blocks.
        if (string.eql(c.dbtype, "mongodb")) {
            let cmd = parseFind(f.sql);
            let mres = await mongoFind(c.dsn, c.dbname, cmd.coll, cmd.field, cmd.value, Db.QUERY_ROW_CAP);
            return response.Response(Status.Ok, mongoResultsPane(mres))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let result = await runQuery(c.dbtype, c.dsn, f.sql);
        return response.Response(Status.Ok, resultsPane(result))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}
