// The results-pane body, swapped into #results-body after a run. It carries both the
// Results view (the grid) and the Messages view (execution status / error); the tab
// buttons in the pane header toggle between them, and studio.js activates Messages on
// an error, Results otherwise.
import list;
import Shared.Db;

fn rowSummary(r: Db.QueryResult): string {
    if (r.truncated) { return `Showing first ${r.rows.size()} of ${r.rowCount} rows.`; }
    return `${r.rowCount} rows.`;
}

// The grid (Results tab). DDL / no-column / error results show the empty placeholder
// here and put their status in Messages.
fn resultsView(r: Db.QueryResult): Html {
    if (r.ok && r.columns.size() > 0) {
        return <div class="grid-wrap" style="height:100%;overflow:auto">
            <table class="grid">
                <thead>
                    <tr>
                        {for (i in 0..r.columns.size()) { let cn = r.columns.get(i) ?? ""; <th>{cn}</th>; }}
                    </tr>
                </thead>
                <tbody>
                    {for (ri in 0..r.rows.size()) {
                        let row = r.rows.get(ri) ?? list.List<string>();
                        <tr>
                            {for (ci in 0..row.size()) { let cell = row.get(ci) ?? ""; <td>{cell}</td>; }}
                        </tr>;
                    }}
                </tbody>
            </table>
        </div>;
    }
    return <div class="results-empty"><span><i class="ic ic-table"></i>&nbsp;&nbsp;No rows returned. See Messages.</span></div>;
}

// The Messages tab: green success line + counts, or the red error block.
fn messagesView(r: Db.QueryResult): Html {
    if (!r.ok) {
        return <div class="messages">
            <div class="err-title"><i class="ic ic-error"></i> Error executing query:</div>
            <div class="err-body">{r.error}</div>
        </div>;
    }
    return <div class="messages">
        <div class="ok"><i class="ic ic-check"></i> Query executed successfully.</div>
        <div>Rows: {rowSummary(r)}</div>
        <div class="muted">Ready.</div>
    </div>;
}

pub fn resultsPane(r: Db.QueryResult): Html {
    return <div class="tabwrap" data-error={errorFlag(r)} style="height:100%">
        <div class="tabview" data-view="results" style="height:100%">{resultsView(r)}</div>
        <div class="tabview hidden" data-view="messages">{messagesView(r)}</div>
    </div>;
}

// "1" when the run failed, so studio.js can switch to the Messages tab; "0" otherwise.
fn errorFlag(r: Db.QueryResult): string {
    if (r.ok) { return "0"; }
    return "1";
}
