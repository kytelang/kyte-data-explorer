// The SQL editor panel, loaded into the content pane. The editor itself is a Monaco
// client-side island: `#editor` is an empty div that studio.js turns into a Monaco
// editor after this fragment is swapped in (it listens for htmx:afterSwap). The editor
// mirrors its text into the hidden `#sql-src` textarea on every keystroke, so the Run
// button (and Cmd/Ctrl+Enter) can htmx-POST the SQL via `hx-include="#sql-src"`, with
// the grid coming back into `#results`.
pub fn queryPanel(connected: bool, label: string): Html {
    return <div class="query-view">
        <div class="query-head">
            <span class="query-title">SQL</span>
            <button id="run-btn" class="primary run-btn"
                    hx-post="/query"
                    hx-include="#sql-src"
                    hx-target="#results"
                    hx-swap="innerHTML"
                    hx-indicator="#run-spin">Run</button>
            <span id="run-spin" class="htmx-indicator muted">running...</span>
            <span class="query-conn muted">{label}</span>
        </div>
        <textarea id="sql-src" name="sql" class="sql-hidden"></textarea>
        <div id="editor" class="sql-editor"></div>
        <div id="results" class="results">
            <p class="muted">Type a query and press Run, or Cmd/Ctrl+Enter.</p>
        </div>
    </div>;
}
