// One table's (or view's) detail, lazily loaded into its tree node: Columns, Constraints,
// Indexes, Foreign Keys and Triggers. All are collapsible <details>; Columns opens by
// default. Empty sections show a muted "No ..." line so the shape is always visible.
import list;
import Shared.Db;

pub fn tableDetail(table: string, cols: list.List<Db.ColumnInfo>, cons: list.List<Db.ConstraintInfo>, idxs: list.List<Db.IndexInfo>, fks: list.List<Db.FkInfo>, trigs: list.List<string>): Html {
    return <div class="oe-detail">
        <details open class="oe-subfolder">
            <summary><div class="oe-row subfolder"><span class="ficon"></span><span class="name">Columns</span></div></summary>
            <div class="oe-leaves">
                {if (cols.size() == 0) { <div class="oe-none">No columns</div>; }}
                {for (i in 0..cols.size()) {
                    let c = cols.get(i) ?? Db.ColumnInfo("", "", false, false);
                    <div class="oe-col">
                        {if (c.primaryKey) { <span class="pk" title="Primary key"><i class="ic ic-key"></i></span>; }}
                        <span>{c.name}</span><span class="type">({c.dataType})</span>
                        {if (!c.nullable) { <span class="req" title="Not null">not null</span>; }}
                    </div>;
                }}
            </div>
        </details>
        <details class="oe-subfolder">
            <summary><div class="oe-row subfolder"><span class="ficon"></span><span class="name">Constraints</span></div></summary>
            <div class="oe-leaves">
                {if (cons.size() == 0) { <div class="oe-none">No constraints</div>; }}
                {for (i in 0..cons.size()) {
                    let cn = cons.get(i) ?? Db.ConstraintInfo("", "");
                    <div class="oe-constraint"><span class="ctype">{cn.ctype}</span><span>{cn.name}</span></div>;
                }}
            </div>
        </details>
        <details class="oe-subfolder">
            <summary><div class="oe-row subfolder"><span class="ficon"></span><span class="name">Indexes</span></div></summary>
            <div class="oe-leaves">
                {if (idxs.size() == 0) { <div class="oe-none">No indexes</div>; }}
                {for (i in 0..idxs.size()) {
                    let ix = idxs.get(i) ?? Db.IndexInfo("");
                    <div class="oe-index"><span class="bolt"><i class="ic ic-key"></i></span><span>{ix.name}</span></div>;
                }}
            </div>
        </details>
        <details class="oe-subfolder">
            <summary><div class="oe-row subfolder"><span class="ficon"></span><span class="name">Foreign Keys</span></div></summary>
            <div class="oe-leaves">
                {if (fks.size() == 0) { <div class="oe-none">No foreign keys</div>; }}
                {for (i in 0..fks.size()) {
                    let fk = fks.get(i) ?? Db.FkInfo("", "");
                    <div class="oe-fk"><span class="bolt"><i class="ic ic-key"></i></span><span>{fk.name}</span><span class="type">{fk.detail}</span></div>;
                }}
            </div>
        </details>
        <details class="oe-subfolder">
            <summary><div class="oe-row subfolder"><span class="ficon"></span><span class="name">Triggers</span></div></summary>
            <div class="oe-leaves">
                {if (trigs.size() == 0) { <div class="oe-none">No triggers</div>; }}
                {for (i in 0..trigs.size()) {
                    let t = trigs.get(i) ?? "";
                    <div class="oe-trigger"><span class="bolt"><i class="ic ic-bolt"></i></span><span>{t}</span></div>;
                }}
            </div>
        </details>
    </div>;
}
