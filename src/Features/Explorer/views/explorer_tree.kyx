// The object explorer: a list of connection roots, with the ACTIVE one expanded into a
// lazy tree that mirrors what pgAdmin / MySQL Workbench show:
//
//   server -> Databases -> database -> [Schemas -> schema ->] categories
//   categories: Tables, Views, Materialized Views, Sequences, Procedures, Functions
//   table/view -> Columns, Constraints, Indexes, Foreign Keys, Triggers
//
// Every level loads on first expand via htmx. `pfx` is the parent node's DOM id, threaded
// down so each child container has a unique, name-safe id (`<pfx>-<letter><index>`),
// letting several branches be open at once without id collisions. Folders use native
// <details>/<summary>, so expand and collapse need no JS.
import list;
import string;
import Shared.Session;
import Shared.Db;

// The whole explorer body: the empty state, otherwise one block per open connection.
// `dbs`/`colls` belong to the ACTIVE connection.
pub fn explorerRoots(store: Session.ConnStore, dbs: list.List<string>, colls: list.List<string>): Html {
    if (store.conns.size() == 0) {
        return <div class="oe-empty">
            <span class="icon"><i class="ic ic-plug"></i></span>
            <p>No active database connections.</p>
            <button type="button" hx-get="/connect" hx-target="#modal-root" hx-swap="innerHTML">Add Connection</button>
        </div>;
    }
    return <div class="oe-roots">
        {for (i in 0..store.conns.size()) {
            let co = store.conns.get(i);
            if (co != undefined) {
                connBlock(co, co.id == store.activeId, dbs, colls);
            }
        }}
    </div>;
}

fn connBlock(co: Session.Conn, active: bool, dbs: list.List<string>, colls: list.List<string>): Html {
    let idStr = `${co.id}`;
    let engineTag = if (string.eql(co.dbtype, "mongodb")) "mongo" else "sql";
    let cls = if (active) "oe-conn active" else "oe-conn";
    return <div class={cls} data-engine={engineTag} data-conn-id={idStr} data-active={if (active) "1" else "0"}>
        <div class="oe-conn-head" hx-get={"/use?id=" + idStr} hx-target="#modal-root" hx-swap="innerHTML" title="Use this connection">
            <div class="label"><span class="bolt"><i class="ic ic-bolt"></i></span><span class="host">{co.heading()}</span></div>
            {if (active) { <span class="live" title="Active connection"></span>; }}
        </div>
        {if (active) { connBody(co, dbs, colls); }}
    </div>;
}

// The active connection's body: Collections for Mongo, else a Databases folder whose
// members each lazily load their contents (GET /explorer/db).
fn connBody(co: Session.Conn, dbs: list.List<string>, colls: list.List<string>): Html {
    if (string.eql(co.dbtype, "mongodb")) {
        return <div class="oe-conn-body">
            <details open class="oe-folder">
                <summary><div class="oe-row folder"><span class="ficon"></span><span class="name">Collections</span></div></summary>
                <div class="oe-children">
                    {if (colls.size() == 0) { <div class="oe-none">No collections</div>; }}
                    {for (i in 0..colls.size()) {
                        let c = colls.get(i) ?? "";
                        <div class="oe-row table" data-mongo-coll={c}><span><i class="ic ic-collection"></i></span><span class="name">{c}</span></div>;
                    }}
                </div>
            </details>
        </div>;
    }
    let cid = `${co.id}`;
    return <div class="oe-conn-body">
        <details open class="oe-folder">
            <summary><div class="oe-row folder"><span class="ficon"></span><span class="name">Databases</span></div></summary>
            <div class="oe-children">
                {if (dbs.size() == 0) { <div class="oe-none">No databases</div>; }}
                {for (i in 0..dbs.size()) {
                    let dbn = dbs.get(i) ?? "";
                    let pfx = "db-" + cid + "-" + `${i}`;
                    <details class="oe-node">
                        <summary hx-get={"/explorer/db?cid=" + cid + "&dbi=" + `${i}` + "&db=" + dbn + "&pfx=" + pfx}
                                 hx-trigger="click once" hx-target={"#" + pfx} hx-swap="innerHTML">
                            <div class="oe-row db"><span><i class="ic ic-db"></i></span><span class="name">{dbn}</span><span class="chev"></span></div>
                        </summary>
                        <div class="oe-children" id={pfx}><div class="oe-none">Loading...</div></div>
                    </details>;
                }}
            </div>
        </details>
    </div>;
}

// The Schemas folder of a database (PG/MSSQL). Each schema lazily loads its categories.
pub fn schemasFolder(cid: int, db: string, pfx: string, schemas: list.List<string>): Html {
    let cids = `${cid}`;
    return <details open class="oe-folder">
        <summary><div class="oe-row folder"><span class="ficon"></span><span class="name">Schemas</span></div></summary>
        <div class="oe-children">
            {if (schemas.size() == 0) { <div class="oe-none">No schemas</div>; }}
            {for (i in 0..schemas.size()) {
                let sc = schemas.get(i) ?? "";
                let cpfx = pfx + "-s" + `${i}`;
                <details class="oe-node">
                    <summary hx-get={"/explorer/schema?cid=" + cids + "&db=" + db + "&sc=" + sc + "&pfx=" + cpfx}
                             hx-trigger="click once" hx-target={"#" + cpfx} hx-swap="innerHTML">
                        <div class="oe-row db"><span><i class="ic ic-db"></i></span><span class="name">{sc}</span><span class="chev"></span></div>
                    </summary>
                    <div class="oe-children" id={cpfx}><div class="oe-none">Loading...</div></div>
                </details>;
            }}
        </div>
    </details>;
}

// The category folders (Tables, Views, ...) of a database or schema. Each lazily loads
// its object list (GET /explorer/cat).
pub fn catFolders(cid: int, db: string, sc: string, pfx: string, cats: list.List<Db.CatDef>): Html {
    let cids = `${cid}`;
    return <div class="oe-catset">
        {for (i in 0..cats.size()) {
            let cat = cats.get(i) ?? Db.CatDef("", "", false);
            let cpfx = pfx + "-c" + `${i}`;
            <details class="oe-folder">
                <summary hx-get={"/explorer/cat?cid=" + cids + "&db=" + db + "&sc=" + sc + "&cat=" + cat.key + "&pfx=" + cpfx}
                         hx-trigger="click once" hx-target={"#" + cpfx} hx-swap="innerHTML">
                    <div class="oe-row folder"><span class="ficon"></span><span class="name">{cat.label}</span></div>
                </summary>
                <div class="oe-children" id={cpfx}><div class="oe-none">Loading...</div></div>
            </details>;
        }}
    </div>;
}

// The object list of one category. Tables and views are expandable into a detail node;
// other objects (sequences, procedures, functions) are leaf rows.
pub fn catBody(cid: int, db: string, sc: string, cat: string, pfx: string, objs: list.List<string>, expandable: bool): Html {
    let cids = `${cid}`;
    return <div class="oe-children">
        {if (objs.size() == 0) { <div class="oe-none">None</div>; }}
        {for (i in 0..objs.size()) {
            let name = objs.get(i) ?? "";
            let opfx = pfx + "-o" + `${i}`;
            if (expandable) {
                <details class="oe-table">
                    <summary hx-get={"/explorer/table?cid=" + cids + "&db=" + db + "&sc=" + sc + "&name=" + name}
                             hx-trigger="click once" hx-target={"#" + opfx} hx-swap="innerHTML">
                        <div class="oe-row table" data-table={name}><span><i class="ic ic-table"></i></span><span class="name">{name}</span><span class="chev"></span></div>
                    </summary>
                    <div class="oe-children" id={opfx}><div class="oe-none">Loading...</div></div>
                </details>;
            } else {
                <div class="oe-row leaf"><span><i class="ic ic-table"></i></span><span class="name">{name}</span></div>;
            }
        }}
    </div>;
}
