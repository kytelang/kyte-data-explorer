// The object explorer: a list of connection roots (all open connections), with the
// ACTIVE one expanded into a lazy tree:
//
//   server -> Databases -> database -> Tables -> table -> Columns / Indexes / Constraints
//
// Each level loads on first expand via htmx: a database node fetches its Tables folder
// (GET /explorer/tables), and a table node fetches its Columns/Indexes/Constraints
// (GET /explorer/table). Folders use native <details>/<summary>, so expand and collapse
// need no JS. Mongo connections show Collections instead of Databases.
import list;
import string;
import Shared.Session;

// The whole explorer body: the empty state when nothing is connected, otherwise one
// block per open connection. `dbs`/`colls` belong to the ACTIVE connection: `dbs` are
// its databases (SQL), `colls` its collections (Mongo).
pub fn explorerRoots(store: Session.ConnStore, dbs: list.List<string>, colls: list.List<string>): Html {
    if (store.conns.size() == 0) {
        return <div class="oe-empty">
            <span class="icon"><i class="ic ic-plug"></i></span>
            <p>No active database connections.</p>
            <button type="button" hx-get="/connect" hx-target="#modal-root" hx-swap="innerHTML">Add Connection</button>
        </div>;
    }
    return <div class="oe-roots">
        {for (i in 0..store.conns.size()) {
            let co = store.conns.get(i);
            if (co != undefined) {
                connBlock(co, co.id == store.activeId, dbs, colls);
            }
        }}
    </div>;
}

// One connection root. The header selects the connection; the active connection also
// renders its expanded object tree below the header.
fn connBlock(co: Session.Conn, active: bool, dbs: list.List<string>, colls: list.List<string>): Html {
    let idStr = `${co.id}`;
    let engineTag = if (string.eql(co.dbtype, "mongodb")) "mongo" else "sql";
    let cls = if (active) "oe-conn active" else "oe-conn";
    return <div class={cls} data-engine={engineTag} data-conn-id={idStr} data-active={if (active) "1" else "0"}>
        <div class="oe-conn-head" hx-get={"/use?id=" + idStr} hx-target="#modal-root" hx-swap="innerHTML" title="Use this connection">
            <div class="label"><span class="bolt"><i class="ic ic-bolt"></i></span><span class="host">{co.heading()}</span></div>
            {if (active) { <span class="live" title="Active connection"></span>; }}
        </div>
        {if (active) { connBody(co, dbs, colls); }}
    </div>;
}

// The expanded body of the active connection: Collections for Mongo, else a Databases
// folder. Each database lazily htmx-loads its Tables folder when first opened.
fn connBody(co: Session.Conn, dbs: list.List<string>, colls: list.List<string>): Html {
    if (string.eql(co.dbtype, "mongodb")) {
        return <div class="oe-conn-body">
            <details open class="oe-folder">
                <summary><div class="oe-row folder"><span class="ficon"></span><span class="name">Collections</span></div></summary>
                <div class="oe-children">
                    {if (colls.size() == 0) { <div class="oe-none">No collections</div>; }}
                    {for (i in 0..colls.size()) {
                        let c = colls.get(i) ?? "";
                        <div class="oe-row table" data-mongo-coll={c}><span><i class="ic ic-collection"></i></span><span class="name">{c}</span></div>;
                    }}
                </div>
            </details>
        </div>;
    }
    let cid = `${co.id}`;
    return <div class="oe-conn-body">
        <details open class="oe-folder">
            <summary><div class="oe-row folder"><span class="ficon"></span><span class="name">Databases</span></div></summary>
            <div class="oe-children">
                {if (dbs.size() == 0) { <div class="oe-none">No databases</div>; }}
                {for (i in 0..dbs.size()) {
                    let dbn = dbs.get(i) ?? "";
                    let dbi = `${i}`;
                    let tid = "tbls-" + cid + "-" + dbi;
                    <details class="oe-database">
                        <summary hx-get={"/explorer/tables?cid=" + cid + "&dbi=" + dbi + "&db=" + dbn}
                                 hx-trigger="click once"
                                 hx-target={"#" + tid}
                                 hx-swap="innerHTML">
                            <div class="oe-row db"><span><i class="ic ic-db"></i></span><span class="name">{dbn}</span><span class="chev"></span></div>
                        </summary>
                        <div class="oe-children" id={tid}><div class="oe-none">Loading...</div></div>
                    </details>;
                }}
            </div>
        </details>
    </div>;
}

// The Tables folder for one database (returned by GET /explorer/tables). Each table is a
// node that lazily loads its Columns/Indexes/Constraints on first expand. `cid`/`dbi`
// build DOM ids unique across every database expanded in the tree.
pub fn tablesFolder(cid: int, dbi: int, db: string, tables: list.List<string>): Html {
    let cids = `${cid}`;
    let dbis = `${dbi}`;
    return <details open class="oe-folder">
        <summary><div class="oe-row folder"><span class="ficon"></span><span class="name">Tables</span></div></summary>
        <div class="oe-children">
            {if (tables.size() == 0) { <div class="oe-none">No tables found</div>; }}
            {for (i in 0..tables.size()) {
                let tbl = tables.get(i) ?? "";
                let did = "det-" + cids + "-" + dbis + "-" + `${i}`;
                <details class="oe-table">
                    <summary hx-get={"/explorer/table?cid=" + cids + "&db=" + db + "&name=" + tbl}
                             hx-trigger="click once"
                             hx-target={"#" + did}
                             hx-swap="innerHTML">
                        <div class="oe-row table" data-table={tbl}><span><i class="ic ic-table"></i></span><span class="name">{tbl}</span><span class="chev"></span></div>
                    </summary>
                    <div class="oe-children" id={did}><div class="oe-none">Loading...</div></div>
                </details>;
            }}
        </div>
    </details>;
}
