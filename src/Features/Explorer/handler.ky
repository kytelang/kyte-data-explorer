// The Explorer feature handlers, over the shared ConnStore.
//
// GET /explorer        -> all connection roots; the active one expanded to its user
//                         tables (SQL) or collections (Mongo), each an htmx-expandable node.
// GET /explorer/table  -> one table's columns and indexes (active connection), loaded
//                         when the node is expanded.
import web.routing;
import web.response;
import web.status;
import list;
import Shared.Session;
import Shared.Db;
import Shared.Mongo;
import Features.Explorer.command;
import Features.Explorer.views.explorer_tree;
import Features.Explorer.views.table_detail;

pub struct ExplorerHandler impl RouteHandler {
    store: ConnStore,
    init(store: ConnStore) { self.store = store; }

    async fn serve(self: ExplorerHandler, ctx: Context): Response {
        let s = self.store;
        let empty = list.List<string>();
        let c = s.active();
        if (c == undefined) {
            return response.Response(Status.Ok, explorerRoots(s, empty, empty))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        if (string.eql(c.dbtype, "mongodb")) {
            let colls = await mongoListCollections(c.dsn, c.dbname);
            return response.Response(Status.Ok, explorerRoots(s, empty, colls))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let tables = await listTables(c.dbtype, c.dsn);
        return response.Response(Status.Ok, explorerRoots(s, tables, empty))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}

// GET /explorer/table?name=X: columns + indexes of one table on the active connection.
pub struct TableDetailHandler impl RouteHandler {
    store: ConnStore,
    init(store: ConnStore) { self.store = store; }

    async fn serve(self: TableDetailHandler, ctx: Context): Response {
        let q = ctx.bind<TableQuery>();
        let c = self.store.active();
        if (c == undefined) {
            return response.Response(Status.Ok, response.raw("<div class=\"muted\">Not connected.</div>"))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let cols = await listColumns(c.dbtype, c.dsn, q.name);
        let idxs = await listIndexes(c.dbtype, c.dsn, q.name);
        return response.Response(Status.Ok, tableDetail(q.name, cols, idxs))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}
