// The Explorer feature handlers. Both read the shared active connection.
//
// GET /explorer          -> the object tree: the connected database's user tables,
//                           each an htmx-expandable node.
// GET /explorer/table    -> one table's columns and indexes, loaded into the node
//                           when the user expands it.
//
// Neither handler holds a live pool: they call the introspection helpers in
// Shared/Db.ky, which open a short-lived pool from the stored connection parameters.
import web.routing;
import web.response;
import web.status;
import list;
import Shared.Session;
import Shared.Db;
import Features.Explorer.command;
import Features.Explorer.views.explorer_tree;
import Features.Explorer.views.table_detail;

// GET /explorer: render the tree. When nothing is connected yet, render the empty
// state so the panel is self-consistent whether loaded on the connected event or by
// hand.
pub struct ExplorerHandler impl RouteHandler {
    conn: ActiveConnection,
    init(conn: ActiveConnection) { self.conn = conn; }

    async fn serve(self: ExplorerHandler, ctx: Context): Response {
        if (!self.conn.connected) {
            return response.Response(Status.Ok, explorerTree(list.List<string>(), false, ""))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let tables = await listTables(self.conn.dbtype, self.conn.dsn);
        return response.Response(Status.Ok, explorerTree(tables, true, self.conn.label()))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}

// GET /explorer/table?name=X: render the columns and indexes of one table.
pub struct TableDetailHandler impl RouteHandler {
    conn: ActiveConnection,
    init(conn: ActiveConnection) { self.conn = conn; }

    async fn serve(self: TableDetailHandler, ctx: Context): Response {
        let q = ctx.bind<TableQuery>();
        if (!self.conn.connected) {
            return response.Response(Status.Ok, response.raw("<div class=\"muted\">Not connected.</div>"))
                .setHeader("Content-Type", "text/html; charset=utf-8");
        }
        let cols = await listColumns(self.conn.dbtype, self.conn.dsn, q.name);
        let idxs = await listIndexes(self.conn.dbtype, self.conn.dsn, q.name);
        return response.Response(Status.Ok, tableDetail(q.name, cols, idxs))
            .setHeader("Content-Type", "text/html; charset=utf-8");
    }
}
