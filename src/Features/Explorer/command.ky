// The bound query shape for every lazily-expanded explorer node. `ctx.bind<ExplorerQuery>()`
// fills whichever fields are present in the `?...` query string; absent ones stay empty.
// `pfx` is the parent node's DOM id prefix, threaded down so each level can build unique,
// name-safe ids for its children (`<pfx>-<index>`).
@serializable
pub struct ExplorerQuery {
    pub cid: string,    // connection id
    pub dbi: string,    // database index (for id building)
    pub db: string,     // database name
    pub sc: string,     // schema name (empty for MySQL/kaidb)
    pub cat: string,    // object category: tables | views | matviews | sequences | procedures | functions
    pub name: string,   // object (table/view) name
    pub pfx: string,    // parent DOM id prefix
    init() {
        self.cid = "";
        self.dbi = "";
        self.db = "";
        self.sc = "";
        self.cat = "";
        self.name = "";
        self.pfx = "";
    }
}
