// Bound query shapes for the lazily-expanded explorer tree. `ctx.bind<T>()` fills the
// fields from the `?cid=..&db=..&name=..` query string. All are @serializable so the
// framework can bind them.

// GET /explorer/tables?cid=N&dbi=I&db=X : the tables of one database on connection N.
// `dbi` is the database's index within the tree, used only to build unique DOM ids.
@serializable
pub struct DbTablesQuery {
    pub cid: string,
    pub dbi: string,
    pub db: string,
    init() { self.cid = ""; self.dbi = ""; self.db = ""; }
}

// GET /explorer/table?cid=N&db=X&name=T : one table's columns, indexes and constraints.
@serializable
pub struct TableQuery {
    pub cid: string,
    pub db: string,
    pub name: string,
    init() { self.cid = ""; self.db = ""; self.name = ""; }
}
