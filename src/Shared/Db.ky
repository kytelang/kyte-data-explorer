// The database capability layer: it maps a studio connection to the right Kyte
// driver, builds connection strings, PROBES a target at connect time, and reads
// the schema catalog (tables, columns, indexes) for the explorer.
//
// Every call opens a short-lived one-connection pool from the stored connection
// parameters, runs its queries, and tears the pool down. Holding a live,
// driver-varying pool in a long-lived object is the shape we are deliberately
// avoiding for now (see Shared/Session.ky); for a desktop explorer that issues a
// handful of catalog queries per click, the open/close cost is negligible.
//
// Introspection is per-driver: kaidb reads its `sys.*` system catalog; Postgres, MySQL
// and MSSQL read `information_schema` (plus each engine's index catalog). All go through
// the same shared `data.db` result model, so the explorer above this layer is
// driver-neutral. Mongo (document mode) is a later session.
import kaidb;
import postgres;
import mysql;
import mssql;
import data.db;
import data.sql.pool;
import list;
import string;
import datetime;

// The outcome of a connect attempt: whether the target answered, and a human
// message for the UI to show.
pub struct ProbeResult {
    pub ok: bool,
    pub message: string,
    init(ok: bool, message: string) { self.ok = ok; self.message = message; }
}

// One column of a table, as the explorer shows it.
pub struct ColumnInfo {
    pub name: string,
    pub dataType: string,
    pub nullable: bool,
    pub primaryKey: bool,
    init(name: string, dataType: string, nullable: bool, primaryKey: bool) {
        self.name = name; self.dataType = dataType; self.nullable = nullable; self.primaryKey = primaryKey;
    }
}

// One index of a table.
pub struct IndexInfo {
    pub name: string,
    init(name: string) { self.name = name; }
}

// One constraint on a table: its name and its kind (PRIMARY KEY, FOREIGN KEY, UNIQUE,
// CHECK). Read from each engine's `information_schema.table_constraints`; kaidb reports
// its primary key derived from the column catalog.
pub struct ConstraintInfo {
    pub name: string,
    pub ctype: string,
    init(name: string, ctype: string) { self.name = name; self.ctype = ctype; }
}

// One foreign key: its constraint name and a short "-> referenced_table(column)" detail.
pub struct FkInfo {
    pub name: string,
    pub detail: string,
    init(name: string, detail: string) { self.name = name; self.detail = detail; }
}

// One object category shown under a database or schema (Tables, Views, Sequences, ...).
// `key` is the introspection category passed to `listObjects`; `expandable` marks the
// categories whose members drill into a detail node (tables and views).
pub struct CatDef {
    pub label: string,
    pub key: string,
    pub expandable: bool,
    init(label: string, key: string, expandable: bool) { self.label = label; self.key = key; self.expandable = expandable; }
}

// The row cap for an ad-hoc query result. We materialise at most this many rows so a
// careless `SELECT *` on a large table cannot exhaust memory or the page; the results
// pane paginates within the cap and shows a "first N of M" guard when it bites.
pub const QUERY_ROW_CAP: int = 1000;

// One result cell. `isNull` distinguishes a SQL NULL from an empty string, so the grid
// can render NULL as a muted marker rather than a blank that looks like "".
pub struct CellVal {
    pub text: string,
    pub isNull: bool,
    init(text: string, isNull: bool) { self.text = text; self.isNull = isNull; }
}

// A materialised query result for the query panel: the column headers and the row
// cells (built before the pool closes, so nothing borrows freed driver buffers), the
// total row count reported by the driver, a truncation flag, the server-side execution
// time in milliseconds, and any error text. On a failed query `ok` is false and `error`
// carries the driver's message.
pub struct QueryResult {
    pub ok: bool,
    pub columns: list.List<string>,
    pub rows: list.List<list.List<CellVal>>,
    pub rowCount: int,
    pub truncated: bool,
    pub elapsedMs: long,
    pub error: string,
    init() {
        self.ok = false;
        self.columns = list.List<string>();
        self.rows = list.List<list.List<CellVal>>();
        self.rowCount = 0;
        self.truncated = false;
        self.elapsedMs = 0;
        self.error = "";
    }
}

// Builds a kaidb connection string of the form `user:pass@host:port?db=NAME&tls=false`.
// The userinfo prefix is omitted when no user is given (kaidb with auth disabled).
pub fn kaidbDsn(host: string, port: string, user: string, password: string, dbname: string): string {
    let auth = "";
    if (!string.eql(user, "")) { auth = user + ":" + password + "@"; }
    let db = dbname;
    if (string.eql(db, "")) { db = "default"; }
    return auth + host + ":" + port + "?db=" + db + "&tls=false";
}

// Builds the driver-appropriate connection string from the connect-form fields. kaidb
// uses its own `user:pass@host:port?db=..&tls=..` form; the SQL drivers use URL-style
// DSNs. TLS is left off by default here (sslmode=disable / encrypt=false) so a plain
// local instance connects; MSSQL in particular is kept plaintext because TLS to MSSQL
// has a known driver issue. The userinfo prefix is omitted when no user is given.
pub fn dsnFor(dbtype: string, host: string, port: string, user: string, password: string, dbname: string): string {
    if (string.eql(dbtype, "kaidb")) { return kaidbDsn(host, port, user, password, dbname); }
    let auth = "";
    if (!string.eql(user, "")) { auth = user + ":" + password + "@"; }
    let hostPort = host + ":" + port;
    if (string.eql(dbtype, "postgres")) {
        return "postgresql://" + auth + hostPort + "/" + dbname + "?sslmode=disable";
    }
    if (string.eql(dbtype, "mysql")) {
        return "mysql://" + auth + hostPort + "/" + dbname + "?sslmode=disable";
    }
    if (string.eql(dbtype, "mssql")) {
        return "mssql://" + auth + hostPort + "/" + dbname + "?encrypt=false";
    }
    return kaidbDsn(host, port, user, password, dbname);
}

// Escapes a string for inlining as a SQL string literal (wraps in single quotes and
// doubles any embedded quote). Introspection queries inline the table name this way
// rather than binding a parameter, because the four SQL drivers use different
// placeholder markers ($N / ? / @P); a literal is portable. Table names come from the
// engine's own catalog, so this is a defensive escape, not untrusted input.
fn sqlLit(s: string): string {
    let out = "'";
    let i = 0;
    while (i < s.length) {
        let ch = string.slice(s, i, i + 1);
        if (string.eql(ch, "'")) { out = out + "''"; } else { out = out + ch; }
        i = i + 1;
    }
    return out + "'";
}

// True for the SQL drivers whose column catalog reports is_nullable as 'YES'/'NO'
// (Postgres, MySQL, MSSQL). kaidb reports 0/1 and also carries a primary-key flag.
fn isInfoSchemaDriver(dbtype: string): bool {
    return string.eql(dbtype, "postgres") || string.eql(dbtype, "mysql") || string.eql(dbtype, "mssql");
}

// An ` AND table_schema = '<schema>'` clause for the information_schema engines, or an
// empty string for kaidb (no schema layer) or when no schema is given. MySQL passes its
// database name as the schema, which is exactly what `table_schema` matches there.
fn schemaFilter(dbtype: string, schema: string): string {
    if (!isInfoSchemaDriver(dbtype)) { return ""; }
    if (string.eql(schema, "")) { return ""; }
    return " AND table_schema = " + sqlLit(schema);
}

// Opens the right driver pool for a stored connection. An unknown dbtype falls back to
// kaidb so the caller still gets a usable pool rather than a crash (the connect probe
// would already have failed for a truly unsupported target).
fn poolFor(dbtype: string, dsn: string): pool.Pool {
    if (string.eql(dbtype, "postgres")) { return pool.Pool(postgres.PgDriver(), dsn, 1); }
    if (string.eql(dbtype, "mysql")) { return pool.Pool(mysql.MyDriver(), dsn, 1); }
    if (string.eql(dbtype, "mssql")) { return pool.Pool(mssql.MssqlDriver(), dsn, 1); }
    return pool.Pool(kaidb.KyteDriver(), dsn, 1);
}

// Probes a target of any wired dbtype: opens a pool, runs a trivial liveness query,
// tears down. The server is treated as reachable if the query round-trips at all (a
// SQL error still proves the server answered, which is what matters for kaidb, whose
// parser rejects `SELECT 1`); only a connection-class SQLSTATE ("08...") counts as not
// connected. The real schema read happens later, once the connection is active.
pub async fn probe(dbtype: string, host: string, port: string, user: string, password: string, dbname: string): ProbeResult {
    let dsn = dsnFor(dbtype, host, port, user, password, dbname);
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let rs = await conn.query("SELECT 1", list.List<db.DbValue>());
    p.release(conn);
    p.closeAll();
    if (rs.ok()) {
        return ProbeResult(true, "Connected to " + dbtype + " at " + host + ":" + port + ".");
    }
    // kaidb rejects the trivial `SELECT 1` at the parser, so for kaidb ONLY a SQL
    // error still proves the server answered (reachable); only a connection-class
    // SQLSTATE ("08...") means not connected. Every other engine accepts `SELECT 1`,
    // so any error there is a genuine failure to report.
    if (string.eql(dbtype, "kaidb") && !string.startsWith(rs.err.code, "08")) {
        return ProbeResult(true, "Connected to kaidb at " + host + ":" + port + ".");
    }
    return ProbeResult(false, rs.err.message);
}

// Lists the user tables of the active connection, sorted by the query. System
// catalog tables (kaidb `sys.*`, Postgres system schemas) are filtered out so the
// explorer shows only the user's own tables.
// Lists the schemas of a database (Postgres and SQL Server only), with the engine's
// system schemas filtered out. MySQL has no schema layer (a schema is a database) and
// kaidb has none, so both return an empty list and the tree skips the schema level.
pub async fn listSchemas(dbtype: string, dsn: string): list.List<string> {
    let out = list.List<string>();
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let sql = "";
    if (string.eql(dbtype, "postgres")) {
        sql = "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT LIKE 'pg\\_%' AND schema_name <> 'information_schema' ORDER BY schema_name";
    } else if (string.eql(dbtype, "mssql")) {
        sql = "SELECT name FROM sys.schemas WHERE name NOT IN ('sys','INFORMATION_SCHEMA','guest','db_owner','db_accessadmin','db_securityadmin','db_ddladmin','db_backupoperator','db_datareader','db_datawriter','db_denydatareader','db_denydatawriter') ORDER BY name";
    }
    if (!string.eql(sql, "")) {
        let rs = await conn.query(sql, list.List<db.DbValue>());
        if (rs.ok()) {
            let i = 0;
            while (i < rs.rows.size()) {
                out.push(rs.rows.at(i).getText(0));
                i = i + 1;
            }
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the objects of one category within a schema: `cat` is one of "tables", "views",
// "matviews", "sequences", "procedures", "functions". For engines without a schema
// layer (MySQL) the caller passes the database name as `schema`; kaidb only has tables.
pub async fn listObjects(dbtype: string, dsn: string, schema: string, cat: string): list.List<string> {
    let out = list.List<string>();
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let scLit = sqlLit(schema);
    let sql = "";
    if (string.eql(dbtype, "kaidb")) {
        if (string.eql(cat, "tables")) { sql = "SELECT name FROM sys.tables"; }
    } else if (string.eql(cat, "tables")) {
        sql = "SELECT table_name FROM information_schema.tables WHERE table_schema = " + scLit + " AND table_type = 'BASE TABLE' ORDER BY table_name";
    } else if (string.eql(cat, "views")) {
        sql = "SELECT table_name FROM information_schema.views WHERE table_schema = " + scLit + " ORDER BY table_name";
    } else if (string.eql(cat, "matviews")) {
        if (string.eql(dbtype, "postgres")) { sql = "SELECT matviewname FROM pg_matviews WHERE schemaname = " + scLit + " ORDER BY matviewname"; }
    } else if (string.eql(cat, "sequences")) {
        if (string.eql(dbtype, "postgres")) { sql = "SELECT sequence_name FROM information_schema.sequences WHERE sequence_schema = " + scLit + " ORDER BY sequence_name"; }
    } else if (string.eql(cat, "procedures")) {
        sql = "SELECT routine_name FROM information_schema.routines WHERE routine_schema = " + scLit + " AND routine_type = 'PROCEDURE' ORDER BY routine_name";
    } else if (string.eql(cat, "functions")) {
        sql = "SELECT routine_name FROM information_schema.routines WHERE routine_schema = " + scLit + " AND routine_type = 'FUNCTION' ORDER BY routine_name";
    }
    if (!string.eql(sql, "")) {
        let rs = await conn.query(sql, list.List<db.DbValue>());
        if (rs.ok()) {
            let i = 0;
            while (i < rs.rows.size()) {
                let name = rs.rows.at(i).getText(0);
                if (!string.startsWith(name, "sys.")) { out.push(name); }
                i = i + 1;
            }
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the columns of one table, in ordinal order, with type and nullability.
// Postgres primary-key detection needs a catalog join we defer, so `primaryKey`
// is reported only for kaidb for now.
pub async fn listColumns(dbtype: string, dsn: string, schema: string, table: string): list.List<ColumnInfo> {
    let out = list.List<ColumnInfo>();
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let lit = sqlLit(table);
    let scf = schemaFilter(dbtype, schema);
    let info = isInfoSchemaDriver(dbtype);
    let sql = "SELECT name, data_type, is_nullable, is_primary_key FROM sys.columns WHERE table_name = " + lit + " ORDER BY ordinal";
    if (info) {
        sql = "SELECT column_name, data_type, is_nullable FROM information_schema.columns WHERE table_name = " + lit + scf + " ORDER BY ordinal_position";
    }
    let rs = await conn.query(sql, list.List<db.DbValue>());
    if (rs.ok()) {
        let i = 0;
        while (i < rs.rows.size()) {
            let row = rs.rows.at(i);
            let name = row.getText(0);
            let dtype = row.getText(1);
            let nullable = false;
            let pk = false;
            if (info) {
                nullable = string.eql(row.getText(2), "YES");
            } else {
                nullable = !string.eql(row.getText(2), "0");
                pk = !string.eql(row.getText(3), "0");
            }
            out.push(ColumnInfo(name, dtype, nullable, pk));
            i = i + 1;
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the indexes defined on one table.
pub async fn listIndexes(dbtype: string, dsn: string, schema: string, table: string): list.List<IndexInfo> {
    let out = list.List<IndexInfo>();
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let lit = sqlLit(table);
    let sql = "SELECT name FROM sys.indexes WHERE table_name = " + lit;
    if (string.eql(dbtype, "postgres")) {
        let scc = if (string.eql(schema, "")) "" else " AND schemaname = " + sqlLit(schema);
        sql = "SELECT indexname FROM pg_indexes WHERE tablename = " + lit + scc + " ORDER BY indexname";
    } else if (string.eql(dbtype, "mysql")) {
        let scc = if (string.eql(schema, "")) "" else " AND table_schema = " + sqlLit(schema);
        sql = "SELECT DISTINCT index_name FROM information_schema.statistics WHERE table_name = " + lit + scc;
    } else if (string.eql(dbtype, "mssql")) {
        let objLit = if (string.eql(schema, "")) lit else sqlLit(schema + "." + table);
        sql = "SELECT name FROM sys.indexes WHERE object_id = OBJECT_ID(" + objLit + ") AND name IS NOT NULL";
    }
    let rs = await conn.query(sql, list.List<db.DbValue>());
    if (rs.ok()) {
        let i = 0;
        while (i < rs.rows.size()) {
            out.push(IndexInfo(rs.rows.at(i).getText(0)));
            i = i + 1;
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the databases visible on the server, sorted, with the engine's own system
// databases filtered out. kaidb is a single-database engine, so its list is empty and
// the caller falls back to the connected database name.
pub async fn listDatabases(dbtype: string, dsn: string): list.List<string> {
    let out = list.List<string>();
    if (string.eql(dbtype, "kaidb")) { return out; }
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let sql = "";
    if (string.eql(dbtype, "postgres")) {
        sql = "SELECT datname FROM pg_database WHERE datistemplate = false AND datallowconn = true ORDER BY datname";
    } else if (string.eql(dbtype, "mysql")) {
        sql = "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('information_schema','performance_schema','mysql','sys') ORDER BY schema_name";
    } else if (string.eql(dbtype, "mssql")) {
        sql = "SELECT name FROM sys.databases WHERE name NOT IN ('master','tempdb','model','msdb') ORDER BY name";
    }
    if (!string.eql(sql, "")) {
        let rs = await conn.query(sql, list.List<db.DbValue>());
        if (rs.ok()) {
            let i = 0;
            while (i < rs.rows.size()) {
                out.push(rs.rows.at(i).getText(0));
                i = i + 1;
            }
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the constraints defined on one table (primary key, foreign keys, unique, check).
// The SQL engines read `information_schema.table_constraints`; kaidb has no such catalog,
// so its primary key is derived from the column catalog and returned as a single
// PRIMARY KEY constraint when present.
pub async fn listConstraints(dbtype: string, dsn: string, schema: string, table: string): list.List<ConstraintInfo> {
    let out = list.List<ConstraintInfo>();
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let lit = sqlLit(table);
    if (string.eql(dbtype, "kaidb")) {
        let ksql = "SELECT name FROM sys.columns WHERE table_name = " + lit + " AND is_primary_key <> 0 ORDER BY ordinal";
        let krs = await conn.query(ksql, list.List<db.DbValue>());
        if (krs.ok() && krs.rows.size() > 0) {
            let cols = "";
            let i = 0;
            while (i < krs.rows.size()) {
                if (i > 0) { cols = cols + ", "; }
                cols = cols + krs.rows.at(i).getText(0);
                i = i + 1;
            }
            out.push(ConstraintInfo("PRIMARY KEY (" + cols + ")", "PRIMARY KEY"));
        }
        p.release(conn);
        p.closeAll();
        return out;
    }
    let scf = schemaFilter(dbtype, schema);
    let sql = "SELECT constraint_name, constraint_type FROM information_schema.table_constraints WHERE table_name = " + lit + scf + " ORDER BY constraint_type, constraint_name";
    let rs = await conn.query(sql, list.List<db.DbValue>());
    if (rs.ok()) {
        let i = 0;
        while (i < rs.rows.size()) {
            let row = rs.rows.at(i);
            out.push(ConstraintInfo(row.getText(0), row.getText(1)));
            i = i + 1;
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the foreign keys on one table, each with a "-> referenced_table" detail. kaidb
// has no foreign-key catalog, so its list is empty.
pub async fn listForeignKeys(dbtype: string, dsn: string, schema: string, table: string): list.List<FkInfo> {
    let out = list.List<FkInfo>();
    if (string.eql(dbtype, "kaidb")) { return out; }
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let lit = sqlLit(table);
    let scf = schemaFilter(dbtype, schema);
    let sql = "";
    let hasRef = false;
    if (string.eql(dbtype, "mysql")) {
        sql = "SELECT constraint_name, referenced_table_name, referenced_column_name FROM information_schema.key_column_usage WHERE table_name = " + lit + scf + " AND referenced_table_name IS NOT NULL";
        hasRef = true;
    } else if (string.eql(dbtype, "postgres")) {
        sql = "SELECT tc.constraint_name, ccu.table_name FROM information_schema.table_constraints tc JOIN information_schema.constraint_column_usage ccu ON tc.constraint_name = ccu.constraint_name AND tc.constraint_schema = ccu.constraint_schema WHERE tc.constraint_type = 'FOREIGN KEY' AND tc.table_name = " + lit + schemaFilter(dbtype, schema) + " ORDER BY tc.constraint_name";
        hasRef = true;
    } else if (string.eql(dbtype, "mssql")) {
        let objLit = if (string.eql(schema, "")) lit else sqlLit(schema + "." + table);
        sql = "SELECT fk.name, OBJECT_NAME(fk.referenced_object_id) FROM sys.foreign_keys fk WHERE fk.parent_object_id = OBJECT_ID(" + objLit + ")";
        hasRef = true;
    }
    if (!string.eql(sql, "")) {
        let rs = await conn.query(sql, list.List<db.DbValue>());
        if (rs.ok()) {
            let i = 0;
            while (i < rs.rows.size()) {
                let row = rs.rows.at(i);
                let detail = "-> " + row.getText(1);
                if (hasRef && string.eql(dbtype, "mysql")) { detail = "-> " + row.getText(1) + "(" + row.getText(2) + ")"; }
                out.push(FkInfo(row.getText(0), detail));
                i = i + 1;
            }
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Lists the trigger names defined on one table. kaidb has no triggers, so its list is
// empty.
pub async fn listTriggers(dbtype: string, dsn: string, schema: string, table: string): list.List<string> {
    let out = list.List<string>();
    if (string.eql(dbtype, "kaidb")) { return out; }
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let lit = sqlLit(table);
    let sql = "";
    if (string.eql(dbtype, "postgres")) {
        let scc = if (string.eql(schema, "")) "" else " AND event_object_schema = " + sqlLit(schema);
        sql = "SELECT DISTINCT trigger_name FROM information_schema.triggers WHERE event_object_table = " + lit + scc + " ORDER BY trigger_name";
    } else if (string.eql(dbtype, "mysql")) {
        let scc = if (string.eql(schema, "")) "" else " AND event_object_schema = " + sqlLit(schema);
        sql = "SELECT DISTINCT trigger_name FROM information_schema.triggers WHERE event_object_table = " + lit + scc + " ORDER BY trigger_name";
    } else if (string.eql(dbtype, "mssql")) {
        let objLit = if (string.eql(schema, "")) lit else sqlLit(schema + "." + table);
        sql = "SELECT t.name FROM sys.triggers t WHERE t.parent_id = OBJECT_ID(" + objLit + ") ORDER BY t.name";
    }
    if (!string.eql(sql, "")) {
        let rs = await conn.query(sql, list.List<db.DbValue>());
        if (rs.ok()) {
            let i = 0;
            while (i < rs.rows.size()) {
                out.push(rs.rows.at(i).getText(0));
                i = i + 1;
            }
        }
    }
    p.release(conn);
    p.closeAll();
    return out;
}

// Runs an arbitrary SQL statement typed into the query panel and materialises the
// result into owned strings. Everything is copied out of the driver's result set
// BEFORE the pool is closed, so the returned `QueryResult` never borrows freed driver
// buffers. Rows are capped at QUERY_ROW_CAP; `truncated` says whether more existed.
// A failed statement returns ok=false with the driver's message in `error`.
// Make an editor buffer safe to hand to the driver as a single statement. kaidb's parser
// is strict: it rejects both a trailing `;` and `--` line comments (UnexpectedToken),
// whereas the SQL servers tolerate them. So we drop whole-line `--` comments and any
// trailing terminator/whitespace. This is line-level (only lines whose trimmed text
// starts with `--`), so an inline `--` inside a string literal is left untouched.
fn sanitizeSql(sql: string): string {
    let lines = string.split(sql, "\n");
    let out = "";
    let n = 0;
    let i = 0;
    while (i < lines.size()) {
        let line = lines.get(i) ?? "";
        let t = string.trim(line);
        let isComment = t.length >= 2 && string.eql(string.slice(t, 0, 2), "--");
        if (!isComment) {
            if (n > 0) { out = out + "\n"; }
            out = out + line;
            n = n + 1;
        }
        i = i + 1;
    }
    // Strip trailing terminator + whitespace.
    let s = string.trim(out);
    while (s.length > 0) {
        let last = string.slice(s, s.length - 1, s.length);
        if (string.eql(last, ";") || string.eql(last, " ") || string.eql(last, "\n") || string.eql(last, "\t") || string.eql(last, "\r")) {
            s = string.slice(s, 0, s.length - 1);
        } else {
            break;
        }
    }
    return s;
}

pub async fn runQuery(dbtype: string, dsn: string, sql: string): QueryResult {
    let r = QueryResult();
    let p = poolFor(dbtype, dsn);
    let conn = await p.acquire();
    let t0 = datetime.nowNs();
    let rs = await conn.query(sanitizeSql(sql), list.List<db.DbValue>());
    let t1 = datetime.nowNs();
    r.elapsedMs = (t1 - t0) / 1000000;
    if (!rs.ok()) {
        r.error = rs.err.message;
        p.release(conn);
        p.closeAll();
        return r;
    }
    r.ok = true;
    let ncols = rs.columns.size();
    let c = 0;
    while (c < ncols) {
        r.columns.push(rs.columns.at(c).name);
        c = c + 1;
    }
    let total = rs.rows.size();
    r.rowCount = total;
    let limit = total;
    if (limit > QUERY_ROW_CAP) { limit = QUERY_ROW_CAP; r.truncated = true; }
    let i = 0;
    while (i < limit) {
        let row = rs.rows.at(i);
        let cells = list.List<CellVal>();
        let j = 0;
        while (j < ncols) {
            if (row.isNull(j)) { cells.push(CellVal("", true)); } else { cells.push(CellVal(row.getText(j), false)); }
            j = j + 1;
        }
        r.rows.push(cells);
        i = i + 1;
    }
    p.release(conn);
    p.closeAll();
    return r;
}
